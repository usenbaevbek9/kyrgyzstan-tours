    } catch (err){
      console.error('Firebase failed to initialise:', err);
    }
  } else {
    console.warn('Firebase is not configured yet — bookings will not be saved. Fill in firebaseConfig in the page source.');
  }

  /* Exposed for the main (non-module) script. Returns the new
     document id, or throws so the caller can show a real error. */
  window.submitBooking = async function(payload){
    if (!db) throw new Error('NOT_CONFIGURED');
    const ref = await addDoc(collection(db, 'bookings'), {
      ...payload,
      createdAt: serverTimestamp(),
      status: 'new',
      source: 'website',
    });
    return ref.id;
  };
  window.bookingBackendReady = !!db;

  /* ---- Admin API ---------------------------------------------------
     Everything here is enforced again by Firestore rules. If the signed-in
     user's UID is not in /admins, these calls fail server-side no matter
     what the browser does. */

  window.adminSignIn = async function(email, password){
    if (!auth) throw new Error('NOT_CONFIGURED');
    const cred = await signInWithEmailAndPassword(auth, email, password);
    // Confirm the account is actually an admin; a valid login is not
    // the same thing as having access.
    const snap = await getDoc(doc(db, 'admins', cred.user.uid));
    if (!snap.exists()){
      await signOut(auth);
      throw new Error('NOT_ADMIN');
    }
    return { uid: cred.user.uid, email: cred.user.email, ...snap.data() };
  };

  window.adminSignOut = async function(){ if (auth) await signOut(auth); };

  window.adminOnAuthChange = function(cb){
    if (!auth) return;
    onAuthStateChanged(auth, async user=>{
      if (!user) return cb(null);
      try {
        const snap = await getDoc(doc(db, 'admins', user.uid));
        cb(snap.exists() ? { uid:user.uid, email:user.email, ...snap.data() } : null);
      } catch { cb(null); }
    });
  };

  window.adminLoadBookings = async function(){
    if (!db) throw new Error('NOT_CONFIGURED');
    const q = query(collection(db,'bookings'), orderBy('createdAt','desc'), limit(500));
    const snap = await getDocs(q);
    return snap.docs.map(d=>{
      const v = d.data();
      return { id:d.id, ...v,
        createdAt: v.createdAt && v.createdAt.toDate ? v.createdAt.toDate().toISOString() : null };
    });
  };

  window.adminUpdateBooking = async function(id, status, note){
    if (!db || !auth || !auth.currentUser) throw new Error('NOT_SIGNED_IN');
    const payload = { status, updatedAt: new Date(), updatedBy: auth.currentUser.email };
    if (note !== undefined) payload.adminNote = note;
    await updateDoc(doc(db,'bookings', id), payload);
  };

  window.adminLoadAdmins = async function(){
    if (!db) throw new Error('NOT_CONFIGURED');
    const snap = await getDocs(collection(db,'admins'));
    return snap.docs.map(d=>({ uid:d.id, ...d.data() }));
  };
</script>

