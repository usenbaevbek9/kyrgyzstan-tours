    const b = document.createElement('button');
    b.className = 'choice-btn month' + ((i+1)===selectedMonth ? ' active' : '');
    b.textContent = monthShort(i);
    b.addEventListener('click', ()=>{ selectedMonth = i+1; renderMonthRow(); });
    box.appendChild(b);
  });
}
function renderDurationRow(){
  const box = document.getElementById('duration-row');
  box.innerHTML = '';
  DURATIONS.forEach(d=>{
    const b = document.createElement('button');
    b.className = 'choice-btn' + (d===selectedDuration ? ' active' : '');
    b.textContent = d + ' ' + tx('days_word');
    b.addEventListener('click', ()=>{ selectedDuration = d; renderDurationRow(); });
    box.appendChild(b);
  });
}
function renderEffortRow(){
  const box = document.getElementById('effort-row');
  box.innerHTML = '';
