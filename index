function setView(v){
  const target = document.getElementById('view-'+v);
  if (!target) return;   // guard: ignore clicks from non-view buttons
  currentView = v;
  document.querySelectorAll('.view').forEach(el=> el.classList.remove('active'));
  target.classList.add('active');
  document.querySelectorAll('#topnav nav button[data-view]').forEach(b=> b.classList.toggle('active', b.dataset.view===v));
  if (v==='map') setTimeout(()=>{
    map.invalidateSize();
    if (!mapEverShown){ mapEverShown = true; map.fitBounds(MAP_BOUNDS, { padding:[20,20] }); }
    clampMinZoom();
  }, 20);
  window.scrollTo({top:0, behavior:'instant' in window ? 'instant':'auto'});
}
