        </div>
        <div style="text-align:right;">
          <span class="st st-${st}">${st}</span>
          <div class="bk-ref" style="margin-top:6px;">${(b.reference || b.id.slice(0,8)).toUpperCase()}</div>
        </div>
      </div>
      <div class="bk-grid">
        <div><span>Email</span><b><a href="mailto:${encodeURIComponent(b.email)}">${escapeHtml(b.email)}</a></b></div>
        <div><span>Phone</span><b>${escapeHtml(b.phone) || '—'}</b></div>
        <div><span>Language</span><b>${escapeHtml(b.prefLang || '—')}</b></div>
        <div><span>Est. value</span><b>$${(b.priceLow||0)*(b.people||1)}–${(b.priceHigh||0)*(b.people||1)}</b></div>
