  .card .card-facts div{ font-size:12px; color:var(--paper); line-height:1.45; }
  .card .card-facts span{
    display:block; font-size:9.5px; text-transform:uppercase; letter-spacing:0.09em;
    color:var(--paper-dim); font-weight:600; margin-bottom:1px;
  }
  .card .card-actions{ display:flex; gap:8px; margin-top:12px; }
  .card .card-actions .btn{ font-size:10.5px; padding:7px 11px; flex:1; text-align:center; }

  /* ---------- MODAL ---------- */
  #modal-overlay{
    position:fixed; inset:0; z-index:200; background:rgba(6,8,11,0.72);
    display:none; align-items:center; justify-content:center; padding:20px;
    backdrop-filter:blur(3px);
