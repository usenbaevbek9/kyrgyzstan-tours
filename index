  }
  .day-row .daybody h4{ font-family:'IBM Plex Sans', sans-serif; font-size:14.5px; font-weight:600; color:var(--paper); margin-bottom:4px; }
  .day-row .daybody p{ font-size:13.5px; color:var(--paper-dim); line-height:1.65; margin:0; }
  #itinerary-note{ font-size:11.5px; color:var(--paper-dim); margin-top:18px; font-style:italic; }
  #reset-plan{ margin-top:16px; }

  /* ---------- INFO VIEW ---------- */
  .info-grid{ display:grid; grid-template-columns:1fr 1fr; gap:20px; margin-top:36px; }
  .info-card{ border:1px solid var(--panel-border); border-radius:4px; padding:20px; background:var(--panel-soft); }
  .info-card h3{ font-size:15px; margin-bottom:10px; color:var(--gold); }
  .info-card ul{ margin:0; padding-left:18px; }
  .info-card li{ font-size:13.5px; color:var(--paper-dim); line-height:1.7; margin-bottom:8px; }
