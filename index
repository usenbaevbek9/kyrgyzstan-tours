  }
  .tag.days{ background:var(--brick); border-color:var(--brick); color:#f5efe0; }
  .tag.effort-easy{ color:#3f5e33; border-color:#8fae66; }
  .tag.effort-moderate{ color:#8a5f14; border-color:#c28a2a; }
  .tag.effort-hard{ color:#8d3a20; border-color:#a8482a; }
  .tour-cost{ text-align:right; flex-shrink:0; }
  .tour-cost b{ display:block; font-family:'Bitter',serif; font-size:21px; font-weight:700; color:var(--paper); }
  .tour-cost span{ font-size:10.5px; color:var(--paper-dim); }
  .tour-summary{ font-size:13.5px; line-height:1.65; color:var(--paper-dim); margin:14px 0 0 0; }
  .tour-body{ display:none; margin-top:18px; padding-top:18px; border-top:1px solid var(--panel-border); }
  .tour-body.open{ display:block; }
  .tour-grid{ display:grid; grid-template-columns:1.15fr 1fr; gap:28px; }
  .tour-grid h4, .tour-costs h4{
    font-family:'IBM Plex Sans',sans-serif; font-size:11px; text-transform:uppercase;
    letter-spacing:0.1em; color:var(--brick); font-weight:600; margin:0 0 12px 0;
  }
  .track-step{ display:flex; gap:12px; padding:0 0 14px 0; position:relative; }
  .track-step:last-child{ padding-bottom:0; }
  .track-day{
    font-family:'Bitter',serif; font-weight:700; font-size:11px; color:var(--paper-dim);
    min-width:44px; padding-top:2px;
  }
  .track-what strong{ display:block; font-size:13.5px; color:var(--paper); font-weight:600; margin-bottom:2px; }
  .track-what span{ font-size:12.5px; color:var(--paper-dim); line-height:1.6; }
  .cost-row{ display:flex; justify-content:space-between; gap:12px; font-size:12.5px; padding:7px 0; border-bottom:1px solid var(--panel-border); }
  .cost-row:last-of-type{ border-bottom:none; }
  .cost-row span:first-child{ color:var(--paper-dim); }
  .cost-row span:last-child{ color:var(--paper); font-weight:500; white-space:nowrap; }
  .tour-advice{ margin-top:22px; padding-top:18px; border-top:1px solid var(--panel-border); }
  .tour-places{ margin-top:20px; padding-top:18px; border-top:1px solid var(--panel-border); }
  .tour-places h4{
    font-family:'IBM Plex Sans',sans-serif; font-size:11px; text-transform:uppercase;
    letter-spacing:0.1em; color:var(--brick); font-weight:600; margin:0 0 12px 0;
  }
  .tour-advice ul{ margin:0; padding-left:18px; }
  .tour-advice li{ font-size:13px; color:var(--paper-dim); line-height:1.7; margin-bottom:7px; }
  #tours-disclaimer{ font-size:11.5px; color:var(--paper-dim); line-height:1.7; margin-top:26px; font-style:italic; max-width:72ch; }
  @media (max-width:760px){
    .tour-grid{ grid-template-columns:1fr; gap:22px; }
    .tour{ padding:18px; }
  }

  /* ---------- PLAN A TRIP ---------- */
  .month-row{ display:flex; gap:6px; flex-wrap:wrap; margin-top:10px; }
  .choice-btn.month{ padding:8px 13px; font-size:11.5px; min-width:52px; }
  .plan-summary{
    border:1px solid var(--panel-border); border-radius:4px; background:var(--panel-soft);
    padding:22px 24px; margin-top:34px;
  }
  .plan-summary h3{ font-size:19px; margin-bottom:16px; }
  .season-stats{ display:flex; gap:34px; flex-wrap:wrap; margin-bottom:16px; }
  .season-stats b{ display:block; font-family:'Bitter',serif; font-size:26px; font-weight:700; color:var(--paper); }
  .season-stats span{ font-size:11px; color:var(--paper-dim); }
  .shut-note{ font-size:13px; line-height:1.7; color:var(--paper-dim); margin:0; border-top:1px solid var(--panel-border); padding-top:14px; }
  .shut-note strong{ color:var(--brick); }
  .plan-section-h{
    font-family:'IBM Plex Sans',sans-serif; font-size:11px; text-transform:uppercase;
    letter-spacing:0.1em; color:var(--brick); font-weight:600; margin:34px 0 14px 0;
  }
  .plan-match{
    border:1px solid var(--panel-border); border-radius:4px; background:var(--panel-soft);
    padding:22px 24px; margin-bottom:14px; position:relative;
  }
  .plan-match.top{ border-color:var(--brick); border-width:2px; }
  .best-badge{
    position:absolute; top:-9px; left:22px;
    background:var(--brick); color:#f5efe0; font-size:9.5px; font-weight:600;
    text-transform:uppercase; letter-spacing:0.1em; padding:3px 10px; border-radius:10px;
  }
  .why-list{ margin:14px 0 16px 0; padding-left:17px; }
  .why-list li{ font-size:12.5px; color:var(--paper-dim); line-height:1.65; margin-bottom:4px; }
  .plan-empty{
    border:1px solid var(--panel-border); border-radius:4px; background:var(--panel-soft); padding:20px 22px;
  }
  .plan-empty p{ font-size:13.5px; line-height:1.7; color:var(--paper-dim); margin:0 0 12px 0; }
  .plan-empty p:last-child{ margin-bottom:0; }
  .plan-empty strong{ color:var(--paper); }
  .place-chips{ display:flex; gap:8px; flex-wrap:wrap; }
  .place-chip{
    display:flex; align-items:center; gap:7px;
    font-size:12px; padding:7px 13px; border-radius:16px;
    border:1px solid var(--panel-border); background:transparent; color:var(--paper);
    transition:background 0.15s ease;
  }
  .place-chip:hover{ background:rgba(43,38,32,0.06); }
  .place-chip .dot{ width:7px; height:7px; border-radius:50%; }
  @media (max-width:760px){
    .season-stats{ gap:22px; }
    .plan-summary, .plan-match{ padding:18px; }
  }

  .page{ max-width:1080px; margin:0 auto; padding:52px 28px 90px 28px; }
  .page .eyebrow{ font-size:11px; color:var(--brick); margin-bottom:12px; text-transform:uppercase; letter-spacing:0.12em; font-weight:600; }
  .page h1{ font-size:33px; line-height:1.15; letter-spacing:-0.015em; max-width:20ch; }
  .page-h1-sm{ font-size:26px; line-height:1.2; letter-spacing:-0.01em; max-width:24ch; margin-bottom:4px; }
  .page-tight{ padding-top:0; }
  .page .lede{ font-size:15.5px; color:var(--paper-dim); max-width:62ch; margin-top:14px; line-height:1.65; }

  .filters-row{ display:flex; gap:26px; flex-wrap:wrap; margin:36px 0 30px 0; }
  .filter-group{ display:flex; flex-direction:column; gap:7px; }
  .filter-group .label{ font-size:10.5px; color:var(--paper-dim); }
  .filter-group .pills{ display:flex; gap:6px; flex-wrap:wrap; }

  .grid{
    display:grid; grid-template-columns:repeat(auto-fill, minmax(260px, 1fr)); gap:20px;
  }
  .card{
    border:1px solid var(--panel-border); border-radius:4px;
    background:var(--panel-soft); padding:20px; cursor:default;
    display:flex; flex-direction:column; gap:9px;
    transition:border-color 0.15s ease;
  }
  .card:hover{ border-color:rgba(43,38,32,0.3); }
  .card .swatch{ width:34px; height:34px; border-radius:50%; display:flex; align-items:center; justify-content:center; font-family:'Bitter',serif; font-weight:700; font-size:14px; color:var(--ink-solid); }
  .card h3{ font-size:17px; line-height:1.25; letter-spacing:-0.01em; }
  .card .region{ font-size:11px; color:var(--paper-dim); text-transform:uppercase; letter-spacing:0.08em; font-weight:500; }
  .card .teaser{ font-size:13.5px; color:var(--paper-dim); line-height:1.65; flex:1; }
  .card .card-facts{
    border-top:1px solid var(--panel-border); padding-top:10px; margin-top:2px;
