  #modal .kind{ font-size:11px; color:var(--gold); }
  #modal h2{ font-size:24px; margin:5px 0 10px 0; }
  #modal p.desc{ font-size:14px; line-height:1.65; color:var(--paper-dim); margin:0 0 18px 0; }
  #modal .modal-sub{
    font-family:'IBM Plex Sans',sans-serif; font-size:11px; text-transform:uppercase;
    letter-spacing:0.1em; color:var(--brick); font-weight:600;
    margin:0 0 9px 0;
  }
  #modal-tips-wrap{ border-top:1px solid var(--panel-border); padding-top:14px; margin-bottom:18px; }
