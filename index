  .tour h3{ font-size:20px; line-height:1.25; letter-spacing:-0.01em; }
  .tour .tour-meta{ display:flex; gap:7px; flex-wrap:wrap; margin-top:9px; }
  .tag{
    font-size:10.5px; text-transform:uppercase; letter-spacing:0.07em; font-weight:600;
    padding:3px 9px; border-radius:11px; border:1px solid var(--panel-border);
