  .choice-btn:hover{ color:var(--paper); }
  .choice-btn.active{ background:var(--brick); border-color:var(--brick); color:#f5efe0; font-weight:500; }
  .plan-block{ margin-top:30px; }
  .plan-block .label{ font-size:11.5px; color:var(--paper-dim); text-transform:none; }
  #build-btn{ margin-top:26px; }
  #itinerary-out{ margin-top:34px; }
  .day-row{
    display:flex; gap:20px; padding:20px 0; border-top:1px solid var(--panel-border);
  }
  .day-row .daynum{
