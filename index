<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<title>Kyrgyzstan — Natural Wonders</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Bitter:wght@400;500;600;700&family=IBM+Plex+Sans:wght@400;500;600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.css">
<script src="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.js"></script>
<style>
  :root{
    --sky-top:#e4dbc4;
    --sky-bottom:#efe8d8;
    --ink:#efe8d8;
    --paper:#2b2620;
    --paper-dim:#6b5f4c;
    --ink-solid:#241f1a;
    --water:#3a3f66;
    --water-bright:#565c8f;
    --brick:#a8482a;
    --green:#4c6b3f;
    --gold:#9c6b1f;
    --panel:rgba(248,244,234,0.92);
    --panel-soft:rgba(43,38,32,0.05);
    --panel-border:rgba(43,38,32,0.16);
    --nav-h:58px;
  }
  *{box-sizing:border-box;}
  html{scroll-behavior:smooth;}
  html,body{
    margin:0; padding:0; width:100%; height:100%;
    background:var(--ink); color:var(--paper);
    font-family:'IBM Plex Sans', sans-serif;
  }
  h1,h2,h3{ font-family:'Bitter', serif; font-weight:700; margin:0; }
  a{ color:inherit; }
  button{ font-family:inherit; cursor:pointer; }
  ::selection{ background:rgba(184,69,46,0.4); }

  /* ---------- TOP NAV ---------- */
  #topnav{
    position:fixed; top:0; left:0; right:0; height:var(--nav-h);
    display:flex; align-items:center; justify-content:space-between;
    padding:0 22px; z-index:100;
    background:rgba(239,232,216,0.92);
    border-bottom:1px solid var(--panel-border);
    backdrop-filter:blur(8px);
  }
  #topnav .brand{ display:flex; align-items:center; gap:9px; flex-shrink:0; margin-right:14px; }
  #topnav .brand .mark{
    width:26px; height:26px; border-radius:50%;
    background:var(--gold); color:var(--ink-solid);
    display:flex; align-items:center; justify-content:center;
    font-family:'Bitter', serif; font-weight:700; font-size:13px;
  }
  #topnav .brand span.title{ font-family:'Bitter', serif; font-size:16px; font-weight:700; }
  #topnav nav{ display:flex; gap:2px; align-items:center; overflow-x:auto; }
  #topnav nav::-webkit-scrollbar{ display:none; }
  @media (max-width:1120px){
    #topnav nav button[data-view]{ padding:8px 10px; font-size:12px; }
  }
  /* One treatment for every nav item — outlined pill, brick fill when active. */
  #topnav nav button[data-view]{
    background:rgba(43,38,32,0.03);
    border:1px solid var(--panel-border);
    color:var(--paper); font-weight:500;
    font-size:12.5px; padding:8px 14px; border-radius:4px;
    margin:0 2px; letter-spacing:0.01em; white-space:nowrap;
    transition:color 0.15s ease, background 0.15s ease, border-color 0.15s ease;
  }
  #topnav nav button[data-view]:hover{
    background:rgba(168,72,42,0.1); border-color:var(--brick); color:var(--brick);
  }
  #topnav nav button[data-view].active{
    background:var(--brick); border-color:var(--brick); color:#f5efe0;
  }

  #lang-switch{
    display:flex; margin-left:12px; border:1px solid var(--panel-border);
    border-radius:4px; overflow:hidden; flex-shrink:0;
  }
  #lang-switch button{
    background:none; border:none; color:var(--paper-dim);
    font-size:11px; font-weight:600; letter-spacing:0.05em;
    padding:8px 9px; transition:all 0.15s ease;
  }
  #lang-switch button:hover{ color:var(--paper); background:rgba(43,38,32,0.06); }
  #lang-switch button.active{ background:var(--paper); color:var(--ink); }

  main{ padding-top:var(--nav-h); }
  .view{ display:none; }
  .view.active{ display:block; }

  /* ---------- MAP VIEW ---------- */
  #view-map.active{ display:block; }
  #map-stage{
    position:fixed; top:var(--nav-h); left:0; right:0; bottom:0;
    background:var(--sky-bottom);
  }
  #leaflet-map{ position:absolute; inset:0; background:var(--sky-bottom); }

  /* OpenStreetMap's default tiles are bright and highly saturated, which
     fights the muted parchment palette. Desaturating + warming them in CSS
     keeps the basemap legible while letting the markers carry the color.
     Done as a filter rather than a different tile provider because every
     muted basemap worth using now requires an API key. */
  .leaflet-tile-pane{
    filter:saturate(0.5) contrast(0.92) brightness(1.04) sepia(0.22);
  }

  /* Leaflet chrome restyled to match the site's dark panel language */
  .leaflet-bottom.leaflet-left{ margin-bottom:20px; margin-left:24px; }
  .leaflet-control-zoom{
    border:1px solid var(--panel-border) !important;
    border-radius:4px !important; overflow:hidden;
    box-shadow:0 2px 8px rgba(43,38,32,0.14) !important;
  }
  .leaflet-control-zoom a{
    background:var(--panel) !important; color:var(--paper) !important;
    width:30px !important; height:30px !important; line-height:30px !important;
    border-bottom:1px solid var(--panel-border) !important;
  }
  .leaflet-control-zoom a:hover{ background:rgba(43,38,32,0.08) !important; }
  .leaflet-control-attribution{
    background:rgba(239,232,216,0.85) !important; color:var(--paper-dim) !important;
    font-size:9.5px !important; backdrop-filter:blur(4px);
  }
  .leaflet-control-attribution a{ color:var(--paper-dim) !important; }
  .leaflet-tooltip.pin-tip{
    background:#f8f4ea; border:1px solid var(--panel-border); color:var(--paper);
    font-family:'IBM Plex Sans', sans-serif; font-size:11px; font-weight:500;
    padding:4px 9px; border-radius:3px;
    box-shadow:0 2px 6px rgba(43,38,32,0.18);
  }
  .leaflet-tooltip.pin-tip::before{ display:none; }

  #map-intro{
    position:absolute; top:20px; left:24px; z-index:600; max-width:290px;
    pointer-events:none;
    background:var(--panel); backdrop-filter:blur(6px);
    border:1px solid var(--panel-border); border-radius:4px;
    box-shadow:0 2px 8px rgba(43,38,32,0.12);
    padding:13px 15px;
  }
  #map-intro h2{ font-size:17px; line-height:1.25; color:var(--paper); }
  #map-intro p{ font-size:12px; color:var(--paper-dim); margin:6px 0 0 0; line-height:1.55; }

  #locations{
    position:absolute; left:24px; top:146px; bottom:96px;
    width:242px; z-index:600;
    background:var(--panel);
    border:1px solid var(--panel-border);
    border-radius:4px;
    backdrop-filter:blur(6px);
    box-shadow:0 4px 16px rgba(43,38,32,0.14);
    display:flex; flex-direction:column;
    overflow:hidden;
    pointer-events:auto;
  }
  #locations .head{
    padding:12px 16px 9px 16px;
    border-bottom:1px solid var(--panel-border);
    font-size:10.5px; color:var(--paper-dim);
    display:flex; justify-content:space-between; align-items:center;
  }
  #filter-pills{ display:flex; gap:5px; flex-wrap:wrap; padding:9px 12px; border-bottom:1px solid var(--panel-border); }
  .pill{
    font-size:10px; padding:4px 9px; border-radius:11px;
    border:1px solid var(--panel-border); background:transparent; color:var(--paper-dim);
    transition:all 0.15s ease;
  }
  .pill:hover{ color:var(--paper); }
  .pill.active{ background:var(--gold); color:var(--ink-solid); border-color:var(--gold); font-weight:500; }
  #loc-list{ overflow-y:auto; flex:1; }
  .loc-item{
    display:flex; gap:10px; align-items:flex-start;
    padding:10px 16px; cursor:pointer;
    border-bottom:1px solid rgba(43,38,32,0.08);
    transition:background 0.15s ease;
  }
  .loc-item:hover{ background:rgba(43,38,32,0.05); }
  .loc-item.active{ background:rgba(184,69,46,0.16); }
  .loc-item .dot{ width:7px; height:7px; border-radius:50%; margin-top:6px; flex-shrink:0; }
  .loc-item .txt .name{ font-size:12.5px; color:var(--paper); font-weight:500; }
  .loc-item .txt .kind{ font-size:10px; color:var(--paper-dim); margin-top:1px; }

  #card{
    position:absolute; right:24px; bottom:24px; z-index:600;
    width:310px;
    background:var(--panel);
    border:1px solid var(--panel-border);
    border-radius:4px;
    backdrop-filter:blur(6px);
    box-shadow:0 4px 16px rgba(43,38,32,0.14);
    padding:18px 20px;
    opacity:0; transform:translateY(8px);
    pointer-events:none;
    transition:opacity 0.25s ease, transform 0.25s ease;
  }
  #card.show{ opacity:1; transform:translateY(0); pointer-events:auto; }
  #card .kind{ font-size:10.5px; color:var(--gold); }
  #card h2{ font-size:20px; margin:4px 0 8px 0; }
  #card p{ font-size:12px; line-height:1.6; color:var(--paper-dim); margin:0 0 10px 0; }
  #card .meta{ display:flex; gap:16px; font-size:10.5px; color:var(--paper-dim); border-top:1px solid var(--panel-border); padding-top:10px; margin-bottom:10px; }
  #card .meta b{ color:var(--paper); display:block; font-size:12.5px; font-weight:500; }
  .btn{
    display:inline-block; font-size:11.5px; padding:8px 14px; border-radius:3px;
    border:1px solid var(--panel-border); background:rgba(43,38,32,0.03); color:var(--paper);
    transition:all 0.15s ease;
  }
  .btn:hover{ background:rgba(43,38,32,0.07); }
  .btn.primary{ background:var(--brick); border-color:var(--brick); color:#f5efe0; }
  .btn.primary:hover{ background:#a03d29; }

  #hint{
    position:absolute; bottom:22px; left:50%; transform:translateX(-50%);
    z-index:500; font-size:11px; color:var(--paper-dim);
    pointer-events:none; opacity:0.9;
    background:rgba(239,232,216,0.9); padding:4px 10px; border-radius:10px;
    border:1px solid var(--panel-border);
  }

  #geo-panel{
    position:absolute; right:24px; top:20px; z-index:600;
    display:flex; flex-direction:column; align-items:flex-end; gap:7px;
    max-width:250px;
  }
  #geo-panel .btn{
    background:var(--panel); backdrop-filter:blur(6px);
    box-shadow:0 2px 8px rgba(43,38,32,0.14);
  }
  #geo-panel .btn[disabled]{ opacity:0.6; cursor:default; }
  #geo-status{
    display:none;
    background:var(--panel); backdrop-filter:blur(6px);
    border:1px solid var(--panel-border); border-radius:4px;
    box-shadow:0 2px 8px rgba(43,38,32,0.14);
    padding:8px 11px; font-size:11.5px; line-height:1.5;
    color:var(--paper-dim); text-align:right;
  }
  #geo-status.show{ display:block; }
  #geo-status b{ color:var(--paper); font-weight:600; }
  .geo-dot{
    width:16px; height:16px; border-radius:50%;
    background:#3a3f66; border:3px solid #f8f4ea;
    box-shadow:0 1px 5px rgba(43,38,32,0.5);
  }

  .pin{
    width:14px; height:14px;
    border-radius:50%; border:2.5px solid #f8f4ea;
    box-shadow:0 1px 4px rgba(43,38,32,0.4);
    cursor:pointer;
    transition:transform 0.15s ease, box-shadow 0.15s ease;
  }
  .pin:hover{ transform:scale(1.3); box-shadow:0 2px 7px rgba(43,38,32,0.5); }
  .pin.selected{ transform:scale(1.45); box-shadow:0 0 0 4px rgba(168,72,42,0.35), 0 2px 7px rgba(43,38,32,0.45); }

  /* ---------- CONTENT SECTIONS (Explore / Plan / Info) ---------- */
  /* ---------- HOME / HERO ---------- */
  .hero{
    position:relative; overflow:hidden;
    padding:76px 28px 64px 28px;
    background:var(--ink);
    border-bottom:1px solid var(--panel-border);
    min-height:520px;
    display:flex; align-items:center; justify-content:center;
  }
  .hero-photo{
    position:absolute; inset:0; width:100%; height:100%;
    object-fit:cover; object-position:center 60%;
    filter:saturate(1.05) contrast(1.05) sepia(0.04);
  }
  .hero-bg{ position:absolute; inset:0; }
  .hero-bg::before{
    content:''; position:absolute; inset:0;
    background:radial-gradient(ellipse 75% 65% at 50% 50%, rgba(239,232,216,0.93) 0%, rgba(239,232,216,0.78) 45%, rgba(239,232,216,0.3) 75%, rgba(239,232,216,0.12) 100%),
               linear-gradient(to top, rgba(239,232,216,0.55) 0%, rgba(239,232,216,0.05) 45%, rgba(239,232,216,0.4) 100%);
  }
  .hero-content{ position:relative; max-width:680px; margin:0 auto; text-align:center; }
  .hero .eyebrow{ font-size:11px; color:var(--brick); letter-spacing:0.12em; margin-bottom:18px; font-weight:600; text-transform:uppercase; }
  .hero h1{ font-size:44px; line-height:1.08; letter-spacing:-0.02em; color:var(--paper); max-width:19ch; margin:0 auto; text-wrap:balance; }
  .hero-sub{ font-size:16px; color:var(--paper-dim); line-height:1.65; margin:20px auto 30px auto; max-width:54ch; }
  .hero-ctas{ display:flex; gap:12px; flex-wrap:wrap; justify-content:center; }
  .btn.lg{ padding:12px 22px; font-size:13px; border-radius:4px; }
  .hero-stats{ display:flex; gap:40px; margin-top:46px; flex-wrap:wrap; justify-content:center; }
  .hero-stats .stat b{ display:block; font-family:'Bitter', serif; font-size:24px; color:var(--paper); font-weight:700; }
  .hero-stats .stat span{ font-size:11px; color:var(--paper-dim); }
  .hero-credit{
    position:absolute; left:0; right:0; bottom:12px; z-index:2;
    text-align:center;
    font-size:9.5px; color:rgba(43,38,32,0.5);
  }

  /* Photo treatment shared by Explore / Home / map cards */
  .card-photo{
    width:100%; aspect-ratio:16/10; border-radius:3px; overflow:hidden;
    background:var(--panel-border); position:relative; margin-bottom:5px;
  }
  .card-photo img{ width:100%; height:100%; object-fit:cover; display:block; }
  .card-photo .fallback{
    position:absolute; inset:0; display:flex; align-items:center; justify-content:center;
    font-family:'Bitter', serif; font-weight:700; font-size:20px; color:var(--ink-solid);
  }

  .cat-grid{ display:grid; grid-template-columns:repeat(auto-fit,minmax(165px,1fr)); gap:12px; margin-top:26px; }
  .cat-tile{
    border:1px solid var(--panel-border); border-radius:4px; background:var(--panel-soft);
    padding:18px 18px 20px 18px; text-align:left; cursor:pointer;
    transition:border-color 0.15s ease, transform 0.15s ease;
  }
  .cat-tile:hover{ border-color:var(--brick); transform:translateY(-2px); }
  .cat-tile .swatch{ width:26px; height:5px; border-radius:3px; margin-bottom:13px; }
  .cat-tile h3{ font-size:16px; margin-bottom:4px; }
  .cat-tile span{ font-size:11.5px; color:var(--paper-dim); }

  .home-tours{ display:grid; grid-template-columns:repeat(auto-fit,minmax(255px,1fr)); gap:14px; margin-top:26px; }
  .home-tour{
    border:1px solid var(--panel-border); border-radius:4px; background:var(--panel-soft);
    padding:18px 20px; cursor:pointer; display:flex; flex-direction:column; gap:8px;
    transition:border-color 0.15s ease;
  }
  .home-tour:hover{ border-color:var(--brick); }
  .home-tour h3{ font-size:16.5px; line-height:1.25; }
  .home-tour .ht-meta{ display:flex; gap:6px; flex-wrap:wrap; }
  .home-tour p{ font-size:12.5px; line-height:1.6; color:var(--paper-dim); margin:0; flex:1; }
  .home-tour .ht-price{ font-family:'Bitter',serif; font-size:16px; font-weight:700; color:var(--paper); }

  .why-grid{ display:grid; grid-template-columns:repeat(auto-fit, minmax(230px,1fr)); gap:20px; margin-top:34px; }
  .why-card{ border:1px solid var(--panel-border); border-radius:4px; padding:20px; background:var(--panel-soft); }
  .why-num{ font-family:'Bitter', serif; font-size:12px; color:var(--brick); margin-bottom:12px; font-weight:700; letter-spacing:0.06em; }
  .why-card h3{ font-size:16px; line-height:1.3; margin-bottom:10px; }
  .why-card p{ font-size:13.5px; color:var(--paper-dim); line-height:1.65; margin:0; }

  @media (max-width:760px){
    .hero{ padding:56px 20px 44px 20px; min-height:auto; }
    .hero h1{ font-size:30px; letter-spacing:-0.015em; }
    .hero-sub{ font-size:15px; margin:16px 0 24px 0; }
    .hero-stats{ gap:22px; margin-top:32px; }
  }

  /* ---------- ADMIN ---------- */
  #admin-login{ max-width:400px; }
  #admin-login .field{ margin-bottom:16px; }
  #admin-panel{ display:none; }
  #admin-panel.show{ display:block; }
  #admin-login.hide{ display:none; }
  #admin-error{
    display:none; font-size:12.5px; line-height:1.55; color:#8d2c1c;
    background:rgba(192,57,43,0.09); border:1px solid rgba(192,57,43,0.3);
    border-radius:3px; padding:10px 12px; margin-bottom:14px;
  }
  #admin-error.show{ display:block; }
  .admin-bar{ display:flex; justify-content:space-between; align-items:flex-end; gap:20px; flex-wrap:wrap; }
  .admin-user{ display:flex; align-items:center; gap:9px; flex-wrap:wrap; }
  .admin-user span{ font-size:12px; color:var(--paper-dim); }
  .admin-stats{ display:grid; grid-template-columns:repeat(auto-fit,minmax(120px,1fr)); gap:12px; margin-top:26px; }
  .admin-stat{
    border:1px solid var(--panel-border); border-radius:4px;
    background:var(--panel-soft); padding:16px 18px;
  }
  .admin-stat b{ display:block; font-family:'Bitter',serif; font-size:24px; font-weight:700; color:var(--paper); }
  .admin-stat span{ font-size:10.5px; text-transform:uppercase; letter-spacing:0.08em; color:var(--paper-dim); font-weight:600; }
  .admin-search{
    font-family:'IBM Plex Sans',sans-serif; font-size:13px; padding:8px 11px;
    border:1px solid var(--panel-border); border-radius:3px; width:100%;
    background:rgba(255,255,255,0.6); color:var(--paper);
  }
  .admin-search:focus{ outline:none; border-color:var(--brick); }
  .bk{
    border:1px solid var(--panel-border); border-radius:4px; background:var(--panel-soft);
    padding:18px 20px; margin-bottom:12px;
  }
  .bk-top{ display:flex; justify-content:space-between; gap:16px; flex-wrap:wrap; align-items:flex-start; }
  .bk-top h3{ font-size:16.5px; margin-bottom:4px; }
  .bk-sub{ font-size:12px; color:var(--paper-dim); }
  .bk-ref{ font-family:'Bitter',serif; font-size:12px; color:var(--paper-dim); }
  .bk-grid{ display:grid; grid-template-columns:repeat(auto-fit,minmax(150px,1fr)); gap:12px; margin:14px 0; padding:14px 0; border-top:1px solid var(--panel-border); border-bottom:1px solid var(--panel-border); }
  .bk-grid div span{ display:block; font-size:9.5px; text-transform:uppercase; letter-spacing:0.08em; color:var(--paper-dim); font-weight:600; }
  .bk-grid div b{ display:block; font-size:13px; color:var(--paper); font-weight:500; margin-top:2px; }
  .bk-msg{ font-size:12.5px; line-height:1.6; color:var(--paper-dim); background:rgba(43,38,32,0.04); padding:10px 12px; border-radius:3px; margin-bottom:14px; }
  .bk-actions{ display:flex; gap:6px; flex-wrap:wrap; align-items:center; }
  .st{
    font-size:10px; text-transform:uppercase; letter-spacing:0.08em; font-weight:600;
    padding:4px 10px; border-radius:11px; border:1px solid var(--panel-border); color:var(--paper-dim);
  }
  .st-new{ background:var(--brick); border-color:var(--brick); color:#f5efe0; }
  .st-contacted{ background:#c28a2a; border-color:#c28a2a; color:#2b2620; }
  .st-confirmed{ background:#4f7340; border-color:#4f7340; color:#f5efe0; }
  .st-declined, .st-cancelled{ background:rgba(43,38,32,0.1); }
  .bk-actions .btn{ font-size:10.5px; padding:6px 11px; }
  .admin-empty{ font-size:13.5px; color:var(--paper-dim); padding:24px 0; }
  #admin-admins{ display:grid; grid-template-columns:repeat(auto-fit,minmax(200px,1fr)); gap:10px; margin-top:14px; }
  .adm{ border:1px solid var(--panel-border); border-radius:4px; padding:12px 14px; background:var(--panel-soft); }
  .adm b{ display:block; font-size:13px; }
  .adm span{ font-size:11px; color:var(--paper-dim); word-break:break-all; }

  /* ---------- BOOKING ---------- */
  #booking-overlay{
    position:fixed; inset:0; z-index:300; background:rgba(43,38,32,0.55);
    display:none; align-items:center; justify-content:center; padding:20px;
    backdrop-filter:blur(3px);
  }
  #booking-overlay.show{ display:flex; }
  #booking-modal{
    width:100%; max-width:560px; background:#f8f4ea;
    border:1px solid var(--panel-border); border-radius:6px;
    padding:26px 28px; position:relative; max-height:90vh; overflow-y:auto;
  }
  #booking-modal .close{
    position:absolute; top:14px; right:14px; background:none; border:none;
    color:var(--paper-dim); font-size:18px; padding:4px 8px;
  }
  #booking-modal .close:hover{ color:var(--paper); }
  #booking-modal .kind{ font-size:10.5px; color:var(--brick); text-transform:uppercase; letter-spacing:0.1em; font-weight:600; }
  #booking-modal h2{ font-size:23px; margin:5px 0 8px 0; }
  #booking-modal .desc{ font-size:13px; line-height:1.6; color:var(--paper-dim); margin:0 0 20px 0; }
  .field-row{ display:flex; gap:14px; }
  .field-row .field{ flex:1; min-width:0; }
