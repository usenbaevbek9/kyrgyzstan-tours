      <button class="btn" id="see-all-btn" style="margin-top:22px;" data-i18n="see_all">See all places →</button>
    </div>

    <footer class="site">
      <p data-i18n="footer">Coordinates, elevations, and access dates sourced from Wikipedia, national park records, and UNESCO listings, verified September 2026. Map data © OpenStreetMap contributors. Photos via Wikimedia Commons, credited individually on each place's detail card. This is an independent project, not an official tourism board.</p>
    </footer>
  </section>

  <!-- ===================== MAP VIEW ===================== -->
  <section id="view-map" class="view">
    <div id="map-stage">
      <div id="leaflet-map"></div>
      <div id="map-intro">
        <h2 data-i18n="map_h2">Explore the project area</h2>
