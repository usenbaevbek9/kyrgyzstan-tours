/* Shared photo block with graceful fallback if a hotlinked Commons
   image ever fails to load (renamed/deleted file, network hiccup) */
function photoHTML(loc){
  const initial = P(loc,'name').charAt(0);
  const bg = CATEGORY_COLOR[loc.category] || '#c28a2a';
  /* Many of the newer entries have no photo file yet — show the coloured
     initial straight away rather than requesting a missing image. */
  if (!loc.photo) return `<div class="fallback" style="display:flex; background:${bg}">${initial}</div>`;
  return `<img src="${loc.photo}" alt="${P(loc,'name')}"
    onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';">
    <div class="fallback" style="display:none; background:${bg}">${initial}</div>`;
}

