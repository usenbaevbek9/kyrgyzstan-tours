/* =========================================================
   GEOLOCATION — "where am I relative to these places"
   Most visitors will be planning from outside Kyrgyzstan, so
   the out-of-bounds case is normal, not an error: we keep the
   map inside MAP_BOUNDS and report the distance to the nearest
   listed place instead of flying off to unrelated territory.
========================================================= */
let geoMarker = null, geoCircle = null;

function haversineKm(lat1, lon1, lat2, lon2){
  const R = 6371, toRad = d => d*Math.PI/180;
  const dLat = toRad(lat2-lat1), dLon = toRad(lon2-lon1);
  const a = Math.sin(dLat/2)**2 +
            Math.cos(toRad(lat1))*Math.cos(toRad(lat2))*Math.sin(dLon/2)**2;
  return R * 2 * Math.asin(Math.sqrt(a));
}

function setGeoStatus(html){
  const el = document.getElementById('geo-status');
  el.innerHTML = html;
  el.classList.add('show');
}

function inProjectArea(lat, lon){
  const [[sLat, wLon], [nLat, eLon]] = MAP_BOUNDS;
  return lat >= sLat && lat <= nLat && lon >= wLon && lon <= eLon;
}

function nearestPlace(lat, lon){
  let nearest = null, nearestKm = Infinity;
  LOCATIONS.forEach(l=>{
    const d = haversineKm(lat, lon, l.lat, l.lon);
    if (d < nearestKm){ nearestKm = d; nearest = l; }
  });
  return { nearest, nearestKm };
}

document.getElementById('locate-btn').addEventListener('click', ()=>{
  const btn = document.getElementById('locate-btn');

  if (!navigator.geolocation){
    setGeoStatus("Your browser doesn't support location.");
    return;
  }

  btn.disabled = true;
  btn.textContent = tx('geo_locating');
  const restore = ()=>{ btn.disabled = false; btn.textContent = tx('geo_btn'); };

  navigator.geolocation.getCurrentPosition(
    pos => {
      restore();
      const { latitude:lat, longitude:lon, accuracy } = pos.coords;

      if (geoMarker) map.removeLayer(geoMarker);
      if (geoCircle) map.removeLayer(geoCircle);

      const { nearest, nearestKm } = nearestPlace(lat, lon);
      const km = nearestKm < 10 ? nearestKm.toFixed(1) : Math.round(nearestKm).toLocaleString();

      if (inProjectArea(lat, lon)){
        geoMarker = L.marker([lat, lon], {
          icon: L.divIcon({ className:'', html:'<div class="geo-dot"></div>', iconSize:[16,16], iconAnchor:[8,8] }),
        }).bindTooltip('You are here', { direction:'top', offset:[0,-10], className:'pin-tip' }).addTo(map);
        geoCircle = L.circle([lat, lon], {
          radius: accuracy, color:'#3a3f66', weight:1, opacity:0.5,
          fillColor:'#3a3f66', fillOpacity:0.1, interactive:false,
        }).addTo(map);
        map.flyTo([lat, lon], Math.min(MAX_ZOOM, 10), { duration:0.9 });
        setGeoStatus(`You're in the area — nearest is <b>${nearest.name}</b>, about <b>${km} km</b> away.`);
      } else {
        /* Outside MAP_BOUNDS: a marker there would sit in territory the
           visitor can never pan to, so we don't place one. */
        geoMarker = null; geoCircle = null;
        setGeoStatus(`You're outside Kyrgyzstan — about <b>${km} km</b> from <b>${nearest.name}</b>. The map stays on the project area.`);
      }
    },
    err => {
      restore();
      const msg = err.code === err.PERMISSION_DENIED
        ? "Location permission denied. You can re-enable it in your browser's site settings."
        : err.code === err.POSITION_UNAVAILABLE
        ? "Your location isn't available right now. Note that browsers block location on pages opened directly from a file — it needs a web server or https."
        : 'Locating timed out. Try again.';
      setGeoStatus(msg);
    },
    { enableHighAccuracy:false, timeout:10000, maximumAge:60000 }
  );
});


