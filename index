document.getElementById('reset-plan').addEventListener('click', ()=>{
  selectedMonth = new Date().getMonth() + 1;
  selectedDuration = 7;
  selectedEffort = 'Any';
  selectedInterests = new Set();
  renderMonthRow(); renderDurationRow(); renderEffortRow(); renderInterestRow();
  document.getElementById('plan-out').innerHTML = '';
});

/* Score a tour against the current selections. Season is a hard
   filter rather than a weighting — recommending a snowed-in pass
   would be actively unhelpful. */
function scoreTour(t){
  if (!t.months.includes(selectedMonth)) return null;
  if (selectedEffort !== 'Any' && t.effort !== selectedEffort) return null;

  let score = 0;
  const reasons = [];

  const diff = selectedDuration - t.days;
  if (diff === 0){ score += 40; reasons.push(`Fits your ${selectedDuration} days exactly`); }
  else if (diff > 0 && diff <= 3){ score += 32; reasons.push(`${t.days} days, leaving ${diff} spare for travel and rest`); }
  else if (diff > 3){ score += 14; reasons.push(`Only ${t.days} days — you could pair it with another route`); }
  else { return null; }

  if (t.months.length <= 2){ score += 12; reasons.push('Only runs in a very short window — this is one of the few months it works'); }

  if (selectedInterests.size){
    const names = t.track.map(s=> s.place.toLowerCase()).join(' ');
    let hits = 0;
    LOCATIONS.forEach(l=>{
      if (selectedInterests.has(l.category) && names.includes(l.name.toLowerCase().split(' ')[0])) hits++;
    });
    if (hits){ score += hits * 8; reasons.push(`Covers ${hits} place${hits>1?'s':''} matching your interests`); }
  }

  if (selectedEffort !== 'Any' && t.effort === selectedEffort) reasons.push(`${t.effort} effort, as you asked`);

  return { tour:t, score, reasons };
}

function buildPlan(){
  const out = document.getElementById('plan-out');
  out.innerHTML = '';
  const monthName = monthFull(selectedMonth-1);

  const openPlaces = LOCATIONS.filter(l=> l.months.includes(selectedMonth) && l.id !== 'bishkek');
  const shutPlaces = LOCATIONS.filter(l=> !l.months.includes(selectedMonth));

  const matches = TOURS.map(scoreTour).filter(Boolean).sort((a,b)=> b.score - a.score);

  /* Season summary first — this is the single most useful thing
     we can tell someone before they book anything. */
  const summary = document.createElement('div');
  summary.className = 'plan-summary';
  const openPct = Math.round(openPlaces.length / (LOCATIONS.length - 1) * 100);
  summary.innerHTML = `
    <h3>${tx('plan_travelling')} ${monthName}</h3>
    <div class="season-stats">
      <div><b>${openPlaces.length}</b><span>${tx('plan_open')}</span></div>
      <div><b>${shutPlaces.length}</b><span>${tx('plan_closed')}</span></div>
      <div><b>${matches.length}</b><span>${tx('plan_routes')}</span></div>
    </div>
    ${shutPlaces.length ? `<p class="shut-note"><strong>Not worth planning around in ${monthName}:</strong> ${shutPlaces.map(p=>P(p,'name')).join(', ')} — snow closes the access roads and passes, and the summer yurt camps are packed away.</p>` : `<p class="shut-note">Everything on this site is reachable in ${monthName}. This is peak season, so book beds ahead.</p>`}`;
  out.appendChild(summary);

  /* Matching routes */
  const h = document.createElement('h3');
  h.className = 'plan-section-h';
  h.textContent = matches.length ? tx('plan_fits') : tx('plan_nofit');
  out.appendChild(h);

  if (!matches.length){
    const none = document.createElement('div');
    none.className = 'plan-empty';
    none.innerHTML = `<p>Nothing in the tour list runs in ${monthName} at ${selectedDuration} days${selectedEffort!=='Any' ? ' at ' + selectedEffort.toLowerCase() + ' effort' : ''}. That is a real answer, not a gap in the data — the high routes genuinely close.</p>
      <p><strong>What still works in ${monthName}:</strong> ${openPlaces.slice(0,6).map(p=>P(p,'name')).join(', ')}. Bishkek, Karakol and the Issyk-Kul shore stay open year-round, and Karakol becomes a ski town from December.</p>
      <p>Try widening the effort filter, or shifting your dates toward July–September when almost everything is open.</p>`;
    out.appendChild(none);
  } else {
    matches.forEach((m, idx)=>{
      const t = m.tour;
      const card = document.createElement('div');
      card.className = 'plan-match' + (idx===0 ? ' top' : '');
      card.innerHTML = `
        ${idx===0 ? '<div class="best-badge">' + tx('plan_best') + '</div>' : ''}
        <div class="tour-head">
          <div style="flex:1; min-width:200px;">
            <h3>${TR(t,'name')}</h3>
            <div class="tour-meta">
              <span class="tag days">${t.days} ${tx('tour_days')}</span>
              <span class="tag effort-${t.effort.toLowerCase()}">${effortLabel(t.effort)}</span>
              <span class="tag">${TR(t,'season')}</span>
            </div>
          </div>
          <div class="tour-cost"><b>$${t.low}–${t.high}</b><span>${tx('tour_pp')}</span></div>
        </div>
        <p class="tour-summary">${TR(t,'summary')}</p>
        <ul class="why-list">${m.reasons.map(r=>`<li>${r}</li>`).join('')}</ul>
        <button class="btn primary see-tour-btn">${tx('plan_seetour')}</button>
        <button class="btn book-btn" style="margin-left:8px;">${tx('bk_book')}</button>`;
      card.querySelector('.book-btn').addEventListener('click', ()=> openBooking(t.id));
      card.querySelector('.see-tour-btn').addEventListener('click', ()=>{
        setView('tours');
        tourLen = 'All'; tourEffort = 'All';
        renderTourPills(); renderTours();
        setTimeout(()=>{
          const all = document.querySelectorAll('#tours-list .tour');
          const target = Array.from(all).find(el=> el.querySelector('h3').textContent === TR(t,'name'));
          if (target){
            const btn = target.querySelector('.tour-toggle');
            if (btn && !target.querySelector('.tour-body').classList.contains('open')) btn.click();
            target.scrollIntoView({ behavior:'smooth', block:'center' });
          }
        }, 80);
      });
      out.appendChild(card);
    });
  }

  /* Places open this month, as a fallback / supplement */
  const ph = document.createElement('h3');
  ph.className = 'plan-section-h';
  ph.textContent = `${tx('plan_openin')} ${monthName}`;
  out.appendChild(ph);

  const chips = document.createElement('div');
  chips.className = 'place-chips';
  openPlaces.forEach(p=>{
    const c = document.createElement('button');
    c.className = 'place-chip';
    c.innerHTML = `<span class="dot" style="background:${CATEGORY_COLOR[p.category]}"></span>${P(p,'name')}`;
    c.addEventListener('click', ()=> openModal(p.id));
    chips.appendChild(c);
  });
  out.appendChild(chips);

  const note = document.createElement('div');
  note.id = 'itinerary-note';
  note.textContent = tx('plan_note');
  out.appendChild(note);

  out.scrollIntoView({ behavior:'smooth', block:'start' });
}
</script>

