/* =========================================================
   PLAN A TRIP — season-aware matcher.
   Kyrgyzstan is intensely seasonal: high lakes and passes open
   for weeks, not months. Rather than assembling a naive one-
   place-per-day list, this matches the researched tours against
   the visitor's month, days and appetite, and is explicit about
   what is shut when they are coming.
========================================================= */
const MONTHS = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
const MONTH_FULL = ['January','February','March','April','May','June',
                    'July','August','September','October','November','December'];
const DURATIONS = [3,5,7,10,14];
const EFFORTS = ['Any','Easy','Moderate','Hard'];

let selectedMonth = new Date().getMonth() + 1;
let selectedDuration = 7;
let selectedEffort = 'Any';
let selectedInterests = new Set();

function renderMonthRow(){
