                       'июле','августе','сентябре','октябре','ноябре','декабре'];

function catLabel(c){ return lang==='ru' ? (CAT_RU[c]||c) : c; }
function regionLabel(r){ return lang==='ru' ? (REGION_RU[r]||r) : r; }
function effortLabel(e){ return lang==='ru' ? (EFFORT_RU[e]||e) : e; }
function monthShort(i){ return lang==='ru' ? MONTHS_RU[i] : MONTHS[i]; }
function monthFull(i){ return lang==='ru' ? MONTH_FULL_RU[i] : MONTH_FULL[i]; }

/* Field accessors — fall back to English when a Russian
   string is missing, so nothing ever renders empty. */
function P(loc, field){
  if (lang==='ru' && RU_PLACES[loc.id] && RU_PLACES[loc.id][field] != null) return RU_PLACES[loc.id][field];
  return loc[field];
}
function TR(tour, field){
  if (lang==='ru' && RU_TOURS[tour.id] && RU_TOURS[tour.id][field] != null) return RU_TOURS[tour.id][field];
  return tour[field];
}

function applyStaticI18n(){
  document.querySelectorAll('[data-i18n]').forEach(el=>{
    const k = el.getAttribute('data-i18n');
    const v = tx(k);
    if (v) el.textContent = v;
  });
  document.documentElement.lang = lang;
}

function setLang(l){
  lang = l;
  document.querySelectorAll('#lang-switch button').forEach(b=>
    b.classList.toggle('active', b.dataset.lang===l));
  applyStaticI18n();
  rerenderAll();
}

function rerenderAll(){
  if (typeof renderMapFilterPills === 'function'){ renderMapFilterPills(); renderLocList(); }
  if (typeof renderExplorePills === 'function'){ renderExplorePills(); renderExploreGrid(); }
  if (typeof renderTourPills === 'function'){ renderTourPills(); renderTours(); }
  if (typeof renderMonthRow === 'function'){
    renderMonthRow(); renderDurationRow(); renderEffortRow(); renderInterestRow();
    const out = document.getElementById('plan-out');
    if (out && out.innerHTML.trim()) buildPlan();
  }
  if (typeof renderHomeContent === 'function') renderHomeContent();
  if (typeof renderInfo === 'function') renderInfo();
  if (selectedId) {
    const loc = LOCATIONS.find(l=>l.id===selectedId);
    if (loc) fillCard(loc);
  }
}


