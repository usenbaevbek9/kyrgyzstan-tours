    b.className = 'choice-btn' + (e===selectedEffort ? ' active' : '');
    b.textContent = effortLabel(e);
    b.addEventListener('click', ()=>{ selectedEffort = e; renderEffortRow(); });
    box.appendChild(b);
  });
}
function renderInterestRow(){
  const box = document.getElementById('interest-row');
  box.innerHTML = '';
  CATEGORIES.filter(c=> c!=='All').forEach(c=>{
    const b = document.createElement('button');
    b.className = 'choice-btn' + (selectedInterests.has(c) ? ' active' : '');
    b.textContent = catLabel(c);
