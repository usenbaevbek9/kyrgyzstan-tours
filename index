/* =========================================================
   MAP CONFIG — the only values you should need to touch to
   move or resize the allowed viewing area later.
========================================================= */
const MAP_CENTER = [41.25, 74.85];           // center of the allowed area
const MAP_BOUNDS  = [[38.9, 69.1], [43.6, 80.6]]; // [SW, NE] — hard pan/zoom-out limit
const MIN_ZOOM = 6;   // fallback floor; the real minimum is computed from screen size below
const MAX_ZOOM = 19;  // OSM's max supported zoom — shows individual buildings

/* =========================================================
   MAP — real basemap tiles (standard OpenStreetMap, no API key
   required), restricted to MAP_BOUNDS via Leaflet's native
   bounds API.
   NOTE: CARTO's free basemaps (used in an earlier version of
   this file) started requiring a signup-gated API key in
   Aug 2026 and now watermark anonymous requests. Standard OSM
   tiles remain genuinely free with no account — they're the
   original open data source every other provider re-serves.
   For higher traffic than OSM's fair-use tile policy allows,
   swap this URL for a paid provider (MapTiler/Stadia/Mapbox)
   or self-hosted tiles; everything else here stays the same.
========================================================= */
let currentView = 'home';
let mapEverShown = false;

const map = L.map('leaflet-map', {
  center: MAP_CENTER,
  zoom: 7,
  minZoom: MIN_ZOOM,
  maxZoom: MAX_ZOOM,
  maxBounds: MAP_BOUNDS,
  maxBoundsViscosity: 1.0,   // hard stop — dragging past the edge has zero elasticity
  zoomControl: false,
  attributionControl: true,
  worldCopyJump: false,
});

L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
  attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors',
  subdomains: 'abc',
  maxZoom: 19,
  noWrap: true,
}).addTo(map);

/* Zoom control lives bottom-left: top-left is the map intro, top-right
   the geolocation panel, and bottom-right the place detail card. */
L.control.zoom({ position:'bottomleft' }).addTo(map);

/* Keep MIN_ZOOM tight to the bounds so visitors can never zoom out
   far enough to see unrelated regions — recomputed on every resize
   since the "right" minimum zoom depends on the viewport size. */
function clampMinZoom(){
  const fitZoom = map.getBoundsZoom(MAP_BOUNDS, false);
  const effectiveMin = Math.max(MIN_ZOOM, fitZoom);
  map.setMinZoom(effectiveMin);
  if (map.getZoom() < effectiveMin) map.setZoom(effectiveMin);
}
/* NOTE: the map view is no longer shown by default (Home is), so its
   container can start at zero size. fitBounds only runs the first
   time a visitor actually opens the Map tab (see setView below) —
   calling it while hidden would compute a bad zoom from a 0px box. */
let resizeTimer=null;
window.addEventListener('resize', ()=>{
  clearTimeout(resizeTimer);
  resizeTimer = setTimeout(()=>{ if(currentView==='map'){ map.invalidateSize(); clampMinZoom(); } }, 150);
});

/* Visual outline of the actual project area drawn on top of the real
   tiles — separate from MAP_BOUNDS, which is the hard rectangular
   limit Leaflet enforces for panning/zooming.
   Only the outer ring of the main polygon is drawn: that's the real
   international boundary — the line actually touching Kazakhstan,
   China, Tajikistan, and Uzbekistan. The interior rings in the source
   data are NOT foreign enclaves; at this dataset's resolution they're
   lakes (Issyk-Kul, Song-Kul, etc.) cut out of the land polygon, which
   is why drawing them made stray triangles appear in the middle of
   lakes with no relation to any actual border. Left out on purpose. */
L.geoJSON({ type:'Polygon', coordinates: [KG_BORDER_GEOM[0][0]] }, {
  style: {
    color:'#a8482a', weight:2, opacity:0.9,
    fill:true, fillColor:'#c98a4b', fillOpacity:0.07,
  },
  interactive: false,
}).addTo(map);

/* ---------------------------------------------------------
   MARKERS
--------------------------------------------------------- */
function pinIcon(category, selected){
  return L.divIcon({
    className: 'pin' + (selected?' selected':''),
    html: '',
    iconSize:[12,12],
    iconAnchor:[6,6],
  });
}
LOCATIONS.forEach(loc=>{
  const marker = L.marker([loc.lat, loc.lon], {
    icon: pinIcon(loc.category, false),
  });
  marker.setIcon(L.divIcon({
    className:'', html:`<div class="pin" style="background:${CATEGORY_COLOR[loc.category]||'#c28a2a'}"></div>`,
    iconSize:[12,12], iconAnchor:[6,6],
  }));
  marker.bindTooltip(P(loc,'name'), { direction:'top', offset:[0,-8], className:'pin-tip' });
