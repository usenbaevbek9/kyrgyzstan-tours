  };

  const configured = !!firebaseConfig.projectId && !firebaseConfig.projectId.startsWith('PASTE_');
  let db = null, auth = null;
  if (configured){
    try {
      const app = initializeApp(firebaseConfig);
      db = getFirestore(app);
