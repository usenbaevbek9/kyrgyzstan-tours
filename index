let tourLen = 'All', tourEffort = 'All';
const TOUR_LENGTHS = ['All','1–4 days','5–7 days','8+ days'];
const TOUR_EFFORTS = ['All','Easy','Moderate','Hard'];

function tourInLength(t){
  if (tourLen === 'All') return true;
  if (tourLen === '1–4 days') return t.days <= 4;
  if (tourLen === '5–7 days') return t.days >= 5 && t.days <= 7;
  return t.days >= 8;
}

function renderTourPills(){
  const lenBox = document.getElementById('tour-len-pills');
  lenBox.innerHTML = '';
  TOUR_LENGTHS.forEach(l=>{
    const p = document.createElement('button');
    p.className = 'pill' + (l===tourLen ? ' active' : '');
    p.textContent = l;
    p.addEventListener('click', ()=>{ tourLen = l; renderTourPills(); renderTours(); });
    lenBox.appendChild(p);
  });
  const effBox = document.getElementById('tour-effort-pills');
  effBox.innerHTML = '';
  TOUR_EFFORTS.forEach(e=>{
    const p = document.createElement('button');
    p.className = 'pill' + (e===tourEffort ? ' active' : '');
    p.textContent = e;
    p.addEventListener('click', ()=>{ tourEffort = e; renderTourPills(); renderTours(); });
    effBox.appendChild(p);
  });
}

function renderTours(){
  const box = document.getElementById('tours-list');
  box.innerHTML = '';
  const shown = TOURS.filter(t=> tourInLength(t) && (tourEffort==='All' || t.effort===tourEffort));

  if (!shown.length){
    box.innerHTML = '<p style="font-size:13.5px; color:var(--paper-dim);">No tours match that combination — try widening the filters.</p>';
    return;
  }

  shown.forEach(t=>{
    const el = document.createElement('div');
    el.className = 'tour';
    el.innerHTML = `
      <div class="tour-head">
        <div style="flex:1; min-width:230px;">
          <h3>${TR(t,'name')}</h3>
          <div class="tour-meta">
            <span class="tag days">${t.days} ${tx('tour_days')}</span>
            <span class="tag effort-${t.effort.toLowerCase()}">${effortLabel(t.effort)}</span>
            <span class="tag">${TR(t,'season')}</span>
          </div>
        </div>
        <div class="tour-cost">
          <b>$${t.low}–${t.high}</b>
          <span>${tx('tour_pp')}</span>
        </div>
      </div>
      <p class="tour-summary">${TR(t,'summary')}</p>
      <button class="btn tour-toggle" style="margin-top:14px;">${tx('tour_show')}</button>
      <button class="btn primary tour-book-btn">${tx('bk_book')}</button>
      <div class="tour-body">
        <div class="tour-grid">
          <div>
            <h4>${tx('tour_track')}</h4>
            ${TR(t,'track').map(s=>`
              <div class="track-step">
                <div class="track-day">${s.day}</div>
                <div class="track-what"><strong>${s.place}</strong><span>${s.what}</span></div>
              </div>`).join('')}
          </div>
          <div class="tour-costs">
            <h4>${tx('tour_costs')}</h4>
            ${TR(t,'costs').map(c=>`<div class="cost-row"><span>${c[0]}</span><span>${c[1]}</span></div>`).join('')}
          </div>
        </div>
        <div class="tour-advice">
          <h4>${tx('tour_advice')}</h4>
          <ul>${TR(t,'advice').map(a=>`<li>${a}</li>`).join('')}</ul>
        </div>
        ${(t.places && t.places.length) ? `<div class="tour-places">
          <h4>${tx('tour_places')}</h4>
          <div class="place-chips">${t.places.map(pid=>{
            const p = LOCATIONS.find(x=>x.id===pid);
            return p ? `<button class="place-chip" data-pid="${p.id}"><span class="dot" style="background:${CATEGORY_COLOR[p.category]}"></span>${P(p,'name')}</button>` : '';
          }).join('')}</div>
        </div>` : ''}
      </div>`;

    el.querySelector('.tour-book-btn').addEventListener('click', ()=> openBooking(t.id));
    el.querySelectorAll('.place-chip').forEach(c=>
      c.addEventListener('click', ()=> openModal(c.dataset.pid)));
    const body = el.querySelector('.tour-body');
    const toggle = el.querySelector('.tour-toggle');
    toggle.addEventListener('click', ()=>{
      const open = body.classList.toggle('open');
      toggle.textContent = open ? tx('tour_hide') : tx('tour_show');
    });
    box.appendChild(el);
  });
}

renderTourPills();
renderTours();

renderExplorePills();
renderExploreGrid();

/* =========================================================
   HOME VIEW — stats strip + featured location cards
========================================================= */
function renderHomeContent(){
  const statsEl = document.getElementById('hero-stats');
  const landscapeTypes = CATEGORIES.filter(c=> c!=='All').length;
  const stats = [
    { n: LOCATIONS.length, label:tx('stat_places') },
    { n: REGIONS.length-1, label:tx('stat_regions') },
    { n: landscapeTypes, label:tx('stat_types') },
  ];
  statsEl.innerHTML = stats.map(s=>`<div class="stat"><b>${s.n}</b><span>${s.label}</span></div>`).join('');

  /* Category tiles — counts come from the data so they can't drift */
  const catGrid = document.getElementById('cat-grid');
  catGrid.innerHTML = '';
  CATEGORY_ORDER.forEach(cat=>{
    const count = LOCATIONS.filter(l=>l.category===cat).length;
    if (!count) return;
    const tile = document.createElement('button');
    tile.className = 'cat-tile';
    tile.innerHTML = `<div class="swatch" style="background:${CATEGORY_COLOR[cat]}"></div>
      <h3>${catLabel(cat)}</h3><span>${count} ${tx('cat_places')}</span>`;
    tile.addEventListener('click', ()=>{
      exploreCategory = cat; exploreRegion = 'All';
      renderExplorePills(); renderExploreGrid();
      setView('explore');
    });
    catGrid.appendChild(tile);
  });

  /* Three tours picked to span short/long and summer/winter rather than
     just the first three in the list */
  const homeTourIds = ['songkul-yurt','alakul-trek','winter-ski'];
  const htBox = document.getElementById('home-tours');
  htBox.innerHTML = '';
  homeTourIds.forEach(id=>{
    const t = TOURS.find(x=>x.id===id);
    if (!t) return;
    const el = document.createElement('div');
    el.className = 'home-tour';
    el.innerHTML = `
      <div class="ht-meta">
        <span class="tag days">${t.days} ${tx('tour_days')}</span>
        <span class="tag effort-${t.effort.toLowerCase()}">${effortLabel(t.effort)}</span>
      </div>
      <h3>${TR(t,'name')}</h3>
      <p>${TR(t,'summary')}</p>
      <div class="ht-price">$${t.low}–${t.high}</div>`;
    el.addEventListener('click', ()=>{
      setView('tours');
      tourLen='All'; tourEffort='All'; renderTourPills(); renderTours();
      setTimeout(()=>{
        const all = document.querySelectorAll('#tours-list .tour');
        const target = Array.from(all).find(x=> x.querySelector('h3').textContent === TR(t,'name'));
        if (target){
          const btn = target.querySelector('.tour-toggle');
          if (btn && !target.querySelector('.tour-body').classList.contains('open')) btn.click();
          target.scrollIntoView({ behavior:'smooth', block:'center' });
        }
      }, 80);
    });
    htBox.appendChild(el);
  });

  const featuredIds = ['issykkul','songkul','jetioguz','sulaiman'];
  const featGrid = document.getElementById('home-featured');
  featGrid.innerHTML = '';
  featuredIds.forEach(id=>{
    const loc = LOCATIONS.find(l=>l.id===id);
    if (!loc) return;
    const card = document.createElement('div');
    card.className='card';
    card.innerHTML = `
      <div class="card-photo">${photoHTML(loc)}</div>
      <h3>${P(loc,'name')}</h3>
      <div class="region">${catLabel(loc.category)} · ${regionLabel(loc.region)}</div>
      <div class="teaser">${P(loc,'desc')}</div>
      <div class="card-actions">
        <button class="btn primary map-btn">${tx('card_seemap')}</button>
      </div>`;
    card.querySelector('.map-btn').addEventListener('click', ()=>{
      setView('map');
      setTimeout(()=> selectLocation(loc.id), 60);
    });
    featGrid.appendChild(card);
  });

}

