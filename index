/* =========================================================
   BOOKING — collects a request and writes it to Firestore.
   Validation runs client-side for UX; the Firestore security
   rules re-validate server-side, because anything enforced
   only in the browser can be bypassed.
========================================================= */
let bookingTour = null;

function openBooking(tourId){
  const tour = TOURS.find(x=> x.id === tourId);
  if (!tour) return;
  bookingTour = tour;

  document.getElementById('booking-kind').textContent = tx('bk_kind');
  document.getElementById('booking-title').textContent = TR(tour,'name');
  document.getElementById('booking-sub').textContent =
    `${tour.days} ${tx('tour_days')} · ${effortLabel(tour.effort)} · $${tour.low}–${tour.high} ${tx('tour_pp')}`;

  document.getElementById('booking-form').style.display = 'block';
  document.getElementById('booking-success').classList.remove('show');
  document.getElementById('booking-error').classList.remove('show');
  document.getElementById('booking-form').reset();
  document.getElementById('bk-people').value = 2;
  document.getElementById('bk-lang').value = lang;
  document.querySelectorAll('#booking-form .invalid').forEach(e=> e.classList.remove('invalid'));

  // don't let people request a date in the past
  const today = new Date().toISOString().split('T')[0];
  document.getElementById('bk-date').min = today;

  applyBookingLabels();
  document.getElementById('booking-overlay').classList.add('show');
}

function closeBooking(){
  document.getElementById('booking-overlay').classList.remove('show');
}

function applyBookingLabels(){
  const map = {
    'lbl-name':'bk_name', 'lbl-email':'bk_email', 'lbl-phone':'bk_phone',
    'lbl-people':'bk_people', 'lbl-date':'bk_date', 'lbl-lang':'bk_lang',
    'lbl-msg':'bk_msg', 'lbl-consent':'bk_consent',
    'booking-submit':'bk_submit', 'booking-cancel':'bk_cancel',
    'booking-note':'bk_note', 'bk-success-h':'bk_success_h', 'booking-done':'bk_done',
  };
  Object.entries(map).forEach(([id,key])=>{
    const el = document.getElementById(id);
    if (el) el.textContent = tx(key);
  });
}

function showBookingError(msg){
  const box = document.getElementById('booking-error');
  box.textContent = msg;
  box.classList.add('show');
}

function validateBooking(){
  const fields = [
    ['bk-name',  v => v.trim().length >= 2],
    ['bk-email', v => /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(v.trim())],
    ['bk-people',v => { const n = Number(v); return Number.isInteger(n) && n >= 1 && n <= 30; }],
    ['bk-date',  v => !!v && new Date(v) >= new Date(new Date().toDateString())],
  ];
  let firstBad = null;
  fields.forEach(([id, test])=>{
    const el = document.getElementById(id);
    const ok = test(el.value);
    el.classList.toggle('invalid', !ok);
    if (!ok && !firstBad) firstBad = el;
  });
  const consent = document.getElementById('bk-consent');
  if (!consent.checked){
    if (!firstBad) firstBad = consent;
  }
  if (firstBad){
    showBookingError(consent.checked ? tx('bk_err_fields') : tx('bk_err_consent'));
    firstBad.focus();
    return false;
  }
  return true;
}

document.getElementById('booking-form').addEventListener('submit', async (e)=>{
  e.preventDefault();
  document.getElementById('booking-error').classList.remove('show');
  if (!validateBooking()) return;

  const btn = document.getElementById('booking-submit');
  btn.disabled = true;
  btn.textContent = tx('bk_sending');

  const payload = {
    tourId:    bookingTour.id,
    tourName:  bookingTour.name,          // English name, stable for your records
    tourDays:  bookingTour.days,
    priceLow:  bookingTour.low,
    priceHigh: bookingTour.high,
    name:      document.getElementById('bk-name').value.trim().slice(0,80),
    email:     document.getElementById('bk-email').value.trim().slice(0,120),
    phone:     document.getElementById('bk-phone').value.trim().slice(0,40),
    people:    Number(document.getElementById('bk-people').value),
    startDate: document.getElementById('bk-date').value,
    prefLang:  document.getElementById('bk-lang').value,
    message:   document.getElementById('bk-msg').value.trim().slice(0,800),
    siteLang:  lang,
  };

  try {
    const id = await window.submitBooking(payload);
    document.getElementById('booking-form').style.display = 'none';
    document.getElementById('bk-success-p').textContent =
      tx('bk_success_p').replace('{ref}', id.slice(0,8).toUpperCase());
    document.getElementById('booking-success').classList.add('show');
  } catch (err){
    console.error('Booking failed:', err);
    showBookingError(err && err.message === 'NOT_CONFIGURED'
      ? tx('bk_err_setup')
      : tx('bk_err_send'));
  } finally {
    btn.disabled = false;
    btn.textContent = tx('bk_submit');
  }
});

document.getElementById('booking-close').addEventListener('click', closeBooking);
document.getElementById('booking-cancel').addEventListener('click', closeBooking);
document.getElementById('booking-done').addEventListener('click', closeBooking);
document.getElementById('booking-overlay').addEventListener('click', (e)=>{
  if (e.target.id === 'booking-overlay') closeBooking();
});
document.addEventListener('keydown', (e)=>{
  if (e.key === 'Escape'){
    closeBooking();
    if (typeof closeModal === 'function') closeModal();
  }
});

