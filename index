    #geo-panel .btn{ font-size:11px; padding:7px 11px; }
    .info-grid{ grid-template-columns:1fr; }
    .page{ padding:40px 20px 70px 20px; }
    .page h1{ font-size:26px; }
    .page-h1-sm{ font-size:23px; }
  }
</style>
</head>
